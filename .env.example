# Whiteboard Capture - Environment Variables Example
# 이 파일은 개발 환경 구성에 필요한 키 목록을 보여주기 위한 템플릿입니다.
# 실제 키를 입력할 때는 이 파일을 복사하여 `.env` 파일을 만들고 사용하세요. (.env는 git에 올라가지 않습니다)

# ---------------------------------------------------------
# 공통 (Common)
# ---------------------------------------------------------
# Spring Boot와 Rust가 토큰을 검증할 때 공통으로 사용할 시크릿 키
JWT_SECRET_KEY=your_super_secret_jwt_key_here_make_it_long

# ---------------------------------------------------------
# 코어 백엔드 (Spring Boot) - /backend-core
# ---------------------------------------------------------
# 데이터베이스 연결 정보
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/whiteboard_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_db_password

# Google OAuth 2.0 클라이언트 정보 (Spring Boot 인증용)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ---------------------------------------------------------
# 고속 백엔드 파이프라인 (Rust) - /backend-fast
# ---------------------------------------------------------
# 데이터베이스 비동기 연결 정보
DATABASE_URL=postgres://postgres:your_db_password@localhost/whiteboard_db

# Oracle Cloud (OCI) Object Storage 접근 정보
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..xxxx
OCI_USER_ID=ocid1.user.oc1..xxxx
OCI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
OCI_PRIVATE_KEY_PATH=/path/to/your/oci/private_key.pem
OCI_REGION=ap-seoul-1
OCI_BUCKET_NAME=whiteboard_images

# ---------------------------------------------------------
# 프론트엔드 (React / Vite) - /web
# ---------------------------------------------------------
# Vite 프론트엔드에서 참조할 백엔드 API 주소 (Vite는 VITE_ 접두어가 필요함)
VITE_API_CORE_URL=http://localhost:8080
VITE_API_FAST_URL=http://localhost:3000
VITE_WS_FAST_URL=ws://localhost:3000/ws
