{
  "name": "whiteboard-capture-orchestrator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "ci:dry-run": "tsc -p tsconfig.json --noEmit && npm run runner:full:mock -- --compact --roles frontend,java,rust,mobile --worker-provider test --concurrency 2 \"auth flow check\"",
    "demo": "tsx src/index.ts",
    "demo:mock": "tsx src/index.ts --mock",
    "runner:prepare": "tsx src/prepareRunner.ts",
    "runner:prepare:mock": "tsx src/prepareRunner.ts --mock",
    "runner:status": "tsx src/runnerStatus.ts",
    "runner:collect": "tsx src/collectResults.ts",
    "runner:execute": "tsx src/runnerExecute.ts",
    "runner:workflow": "tsx src/runnerWorkflow.ts",
    "runner:workflow:safe": "tsx src/runnerWorkflow.ts --compact --concurrency 1",
    "runner:workflow:balanced": "tsx src/runnerWorkflow.ts --compact --concurrency 2",
    "runner:workflow:rehearse": "tsx src/runnerWorkflow.ts --compact --apply --rollback-after-verify --concurrency 1",
    "runner:workflow:reuse": "tsx src/runnerWorkflow.ts --compact --reuse-worker-results --concurrency 1",
    "runner:full": "tsx src/runnerFull.ts",
    "runner:full:safe": "tsx src/runnerFull.ts --compact --concurrency 1",
    "runner:full:balanced": "tsx src/runnerFull.ts --compact --concurrency 2",
    "runner:full:rehearse": "tsx src/runnerFull.ts --compact --apply --rollback-after-verify --concurrency 1",
    "runner:full:mock": "tsx src/runnerFull.ts --mock",
    "runner:cleanup": "tsx src/runnerCleanup.ts",
    "runner:recover": "tsx src/runnerRecover.ts",
    "runner:finalize": "tsx src/runnerFinalize.ts",
    "runner:reports": "tsx src/runnerReports.ts",
    "runner:review": "tsx src/applyReview.ts",
    "project:init": "tsx src/projectInit.ts",
    "project:package": "tsx src/projectPackage.ts",
    "worker:prepare": "tsx src/workerExecutor.ts",
    "worker:run": "tsx src/workerRun.ts",
    "worker:handoff": "tsx src/workerHandoff.ts",
    "apply:prepare": "tsx src/applyExecutor.ts",
    "apply:run": "tsx src/applyRun.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.3.6",
    "@langchain/openai": "^1.4.7",
    "dotenv": "^17.2.3",
    "yaml": "^2.9.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.13.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
